# Newsletter provider endpoint for "Overthinking Real Estate" signups.
# Mailchimp / Flodesk / Kit — whichever Danielle ends up on.
# Never hardcode this in a component; the route handler reads it from here.
NEWSLETTER_ENDPOINT=

# Optional API key, if the provider needs one (Kit, Mailchimp API).
NEWSLETTER_API_KEY=

# IDX / MLS feed. Empty means the mock adapter is used (the default today).
# See design_handoff/README.md, "IDX / MLS" section, before wiring a real feed.
IDX_PROVIDER=
IDX_API_BASE=
IDX_API_KEY=
