# ---------------------------------------------------------------------------
# Every value here is optional. With none of them set the site still builds and
# every page renders honestly — a missing value produces a quieter, truthful
# block, never a broken link. See the launch blockers in README.md.
# ---------------------------------------------------------------------------

# Overthinking Real Estate on Substack — the publication homepage.
# Setting this switches /read and the homepage essay section to the live feed,
# and turns the newsletter block into a real Substack subscribe link.
# Example: https://overthinkingrealestate.substack.com
SUBSTACK_URL=

# Optional override. Defaults to SUBSTACK_URL + /feed.
SUBSTACK_RSS_URL=

# Public contact address. Shown as a real mailto on /contact when set.
# Leave empty rather than inventing one.
CONTACT_EMAIL=

# Where the contact form POSTs. Until this is set the form renders without a
# submit control and says delivery is being connected — it never fake-submits.
CONTACT_FORM_ENDPOINT=

# Canonical origin for sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=
