# ---------------------------------------------------------------------------
# Every value here is an OPTIONAL OVERRIDE. The public defaults — the Substack
# URL and the public contact address — are committed in lib/config.ts so the
# site works on any deploy with no dashboard setup.
#
# NEVER commit a secret. Form endpoints, API keys, service tokens and private
# inbox credentials are environment-only and have no committed default.
# ---------------------------------------------------------------------------

# Overrides the committed Substack publication URL.
# The committed default is a Substack PROFILE URL, which does not expose a
# publication RSS feed — set this to the publication URL (name.substack.com or
# a custom domain) to switch /read and the homepage to the live feed.
SUBSTACK_URL=

# Override the derived feed URL directly, if the publication's feed lives
# somewhere other than <SUBSTACK_URL>/feed.
SUBSTACK_RSS_URL=

# Override where "Subscribe on Substack" points. Derived automatically for a
# publication URL; for a profile URL it points at the profile itself.
SUBSTACK_SUBSCRIBE_URL=

# Overrides the committed public contact address.
CONTACT_EMAIL=

# Public contact phone, e.g. "+13105550142" or "(310) 555-0142".
# Environment-only with NO committed default: publishing a phone number is
# Danielle's decision. Setting this turns on "Text Danielle" (an sms: link) on
# /contact?intent=showing. Leave it unset and that action is not rendered.
CONTACT_PHONE=

# SECRET — environment-only, never committed. Where the contact form POSTs.
# Until this is set the form renders without a submit control and says
# delivery is being connected. It never fake-submits.
CONTACT_FORM_ENDPOINT=

# Canonical origin for sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=
